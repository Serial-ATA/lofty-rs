cff-version: 1.2.0
title: Lofty
message: >-
  If you use this software, please cite it using the
  metadata from this file.
type: software
authors:
  - alias: Serial-ATA
    website: "https://sata.lol"
repository-code: 'https://github.com/Serial-ATA/lofty-rs'
abstract: >-
  Rust audio metadata library: parse, convert, and write
  metadata to various audio formats.
keywords:
  - Rust
  - Audio
license:
  - MIT
  - Apache-2.0
references:
  # == AIFF ==
  - type: standard
    title: "Audio Interchange File Format: \"AIFF\""
    authors:
      - name: Apple Computer, Inc.
    year: 1989
    format: "Portable Document Format"
    url: "https://www.mmsp.ece.mcgill.ca/Documents/AudioFormats/AIFF/Docs/AIFF-1.3.pdf"
    version: "1.3"
  - type: standard
    title: "Audio Interchange File Format AIFF-C"
    authors:
      - name: Apple Computer, Inc.
    year: 1991
    format: "Portable Document Format"
    url: "https://www.mmsp.ece.mcgill.ca/Documents/AudioFormats/AIFF/Docs/AIFF-C.9.26.91.pdf"
  - type: website
    title: "Audio File Format Specifications"
    authors:
      - family-names: Kabal
        given-names: Peter
    format: "HyperText Markup Language"
    url: "https://www.mmsp.ece.mcgill.ca/Documents/AudioFormats/AIFF/AIFF.html"
